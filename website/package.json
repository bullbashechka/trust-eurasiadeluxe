{
  "name": "@eurasia/website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_DEV_BACKGROUND=0 astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "ASTRO_PREVIEW_BACKGROUND=0 astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/tour.test.ts && bun test tests/tour-ui.test.tsx",
    "test:build": "node scripts/check_build.mjs",
    "format": "prettier --write src scripts/*.mjs tests astro.config.mjs"
  },
  "dependencies": {
    "astro": "7.3.1",
    "@astrojs/react": "6.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "gsap": "3.15.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "happy-dom": "^20.14.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3"
  }
}
