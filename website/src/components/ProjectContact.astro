---
import Icon from './Icon';
---
<dialog class="project-contact-dialog" id="project-contact-dialog" aria-labelledby="project-contact-title">
  <div class="project-contact-inner">
    <button type="button" class="project-dialog-close" data-project-contact-close aria-label="Закрыть форму"><Icon name="x"/></button>
    <div data-project-contact-content>
      <p class="project-kicker">EURASIA DE LUXE</p>
      <h2 id="project-contact-title">Узнать больше</h2>
      <p>Демонстрационная форма. Данные не отправляются.</p>
      <form data-project-contact-form novalidate>
        <label for="project-contact-name">Имя</label>
        <input id="project-contact-name" name="name" autocomplete="given-name" maxlength="80" placeholder="Как к вам обращаться" />
        <label for="project-contact-phone">Телефон</label>
        <input id="project-contact-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="24" placeholder="+7 (___) ___-__-__" aria-describedby="project-phone-error" required />
        <span id="project-phone-error" class="project-field-error" aria-live="polite"></span>
        <button class="project-button project-button-filled" type="submit">Проверить данные <span aria-hidden="true"><Icon name="arrow-right"/></span></button>
      </form>
    </div>
    <div data-project-contact-success hidden role="status" tabindex="-1">
      <span class="project-success-mark" aria-hidden="true">✓</span>
      <h2>Данные заполнены корректно</h2>
      <p>Это демонстрация — заявка не отправлена.</p>
      <button class="project-button project-button-filled" type="button" data-project-contact-close>Закрыть</button>
    </div>
  </div>
</dialog>
