---
import Icon from './Icon';
---
<header class="company-header" data-company-header data-site-header>
  <div class="company-container header-inner">
    <a href="/" class="company-wordmark" aria-label="Trust Stroy — главная">TRUST STROY</a>
    <nav class="company-desktop-nav" aria-label="Основная навигация">
      <a href="#about">О компании</a><a href="#projects">Проекты</a><a href="#advantages">Преимущества</a><button type="button" data-contact-open>Оставить заявку</button>
    </nav>
    <button class="company-button header-cta" type="button" data-contact-open>Связаться <span aria-hidden="true"><Icon name="arrow-right"/></span></button>
    <button class="company-menu-toggle" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="company-mobile-menu"><Icon name="menu" className="menu-open-icon"/><Icon name="x" className="menu-close-icon"/></button>
  </div>
  <nav class="company-mobile-menu" id="company-mobile-menu" aria-label="Мобильная навигация" hidden>
    <a href="#about">О компании</a><a href="#projects">Проекты</a><a href="#advantages">Преимущества</a><button type="button" data-contact-open>Оставить заявку</button>
  </nav>
</header>
<script>import '../scripts/company';</script>
