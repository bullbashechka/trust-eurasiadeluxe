---
import Icon from './Icon';
---
<header class="project-header" data-project-header data-site-header>
  <a class="project-menu-button" href="#project-menu" data-project-menu-open aria-label="Меню" aria-haspopup="dialog"><span aria-hidden="true"><Icon name="menu"/></span><span>Меню</span></a>
  <a class="project-wordmark" href="/eurasia-deluxe/" aria-label="Eurasia De Luxe — главная проекта">EURASIA <small>DE LUXE</small></a>
  <a class="project-header-cta" href="/eurasia-deluxe/#apartments">Выбрать квартиру <span aria-hidden="true"><Icon name="arrow-right"/></span></a>
</header>
<dialog class="project-menu" id="project-menu" aria-labelledby="project-menu-title">
  <div class="project-menu-inner">
    <button type="button" class="project-dialog-close" data-project-menu-close aria-label="Закрыть меню"><Icon name="x"/></button>
    <p class="project-kicker">EURASIA DE LUXE</p>
    <h2 id="project-menu-title">Меню</h2>
    <nav aria-label="Навигация по проекту">
      <a href="/eurasia-deluxe/#project">О комплексе</a>
      <a href="/eurasia-deluxe/#architecture">Архитектура</a>
      <a href="/eurasia-deluxe/#apartments">Планировки</a>
      <a class="project-menu-mobile-action" href="/eurasia-deluxe/#apartments">Выбрать квартиру</a>
      <button class="project-menu-mobile-action" type="button" data-project-contact-open>Связаться</button>
      <a href="/">О застройщике</a>
    </nav>
  </div>
</dialog>
