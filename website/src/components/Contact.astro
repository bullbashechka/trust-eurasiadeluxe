---
import Icon from './Icon';
import { whatsappLink } from '../data/contact';
interface Props { area?: string }
const {area} = Astro.props;
const number = import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? '';
const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : '';
const href = whatsappLink(number, area, url);
---
<section class="contact section" id="contact">
  <div><p class="eyebrow">СЛЕДУЮЩИЙ ШАГ</p><h2>Почувствовать,<br/>что вы <em>дома.</em></h2></div>
  <div class="contact-copy"><p>Узнайте больше о квартире{area ? ` ${area} м²` : ''} и договоритесь о личном просмотре.</p>
    {href ? <><a class="button dark" href={href} target="_blank" rel="noopener noreferrer">Записаться на просмотр <span><Icon name="arrow-up-right"/></span></a><a class="text-link" href={whatsappLink(number, area, url, 'price')} target="_blank" rel="noopener noreferrer">Уточнить стоимость <Icon name="arrow-up-right"/></a></> : <><span class="contact-pending">Контакты отдела продаж скоро появятся</span><a class="text-link" href="/eurasia-deluxe/#apartments">Пока посмотреть другие планировки <Icon name="arrow-up-right"/></a></>}
  </div>
</section>
