---
import Icon from '../../components/Icon';
import Layout from '../../layouts/Layout.astro';
import ApartmentCards from '../../components/ApartmentCards.astro';
import ApartmentSelector from '../../components/ApartmentSelector.astro';
---
<Layout title="Eurasia De Luxe — жилой комплекс" image="/media/project-building.webp">
  <section class="project-hero-v2" id="project" aria-labelledby="project-title">
    <img src="/media/project-building.webp" alt="Визуализация жилого комплекса Eurasia De Luxe в вечернем свете" width="1774" height="887" fetchpriority="high" />
    <div class="project-hero-shade" aria-hidden="true"></div>
    <div class="project-title-wrap" data-project-reveal>
      <h1 id="project-title"><span>EURASIA</span><span class="hero-statement">БОЛЬШЕ<br/>ЧЕМ ПРОСТО<br/>ДОМ</span><span>DE LUXE</span></h1>
    </div>
  </section>

  <section class="architecture-v2" id="architecture" aria-labelledby="architecture-title">
    <div class="architecture-title" data-project-reveal>
      <span class="project-rule" aria-hidden="true"></span>
      <h2 id="architecture-title">АРХИТЕКТУРА</h2>
      <p>СОВРЕМЕННАЯ<br/>ГАРМОНИЯ<br/>В ДЕТАЛЯХ</p>
    </div>
    <figure class="architecture-detail" data-project-reveal>
      <img src="/media/architecture-detail.webp" alt="Деталь фасада с архитектурной подсветкой" width="1000" height="1070" loading="lazy" />
      <figcaption>Детали <span aria-hidden="true"></span></figcaption>
    </figure>
    <figure class="architecture-facade" data-project-reveal>
      <img src="/media/project-building.webp" alt="Фасад Eurasia De Luxe" width="1774" height="887" loading="lazy" />
      <figcaption>Фасад <span aria-hidden="true"></span></figcaption>
    </figure>
    <p class="architecture-copy" data-project-reveal>ПРОДУМАННАЯ<br/>АРХИТЕКТУРА<br/>ДЛЯ КОМФОРТНОЙ<br/>ЖИЗНИ</p>
  </section>

  <section class="selection-section" id="apartments" aria-labelledby="apartments-title">
    <div class="selection-heading">
      <p class="project-kicker">EURASIA DE LUXE</p>
      <span class="project-rule" aria-hidden="true"></span>
      <h2 id="apartments-title">Какая квартира<br class="selection-title-break" /> подойдёт вам?</h2>
      <p class="selection-intro">Три планировки. Выберите свою и загляните внутрь.</p>
    </div>
    <ApartmentCards variant="selection" openInNewTab />
    <p class="selection-note">Планировка, детали и виртуальная прогулка — на странице квартиры.</p>
  </section>

  <section class="project-tour-band" aria-label="Начать экскурсию">
    <h2>Сначала —<br/>прогулка по квартире.</h2>
    <button type="button" class="project-button project-button-light" data-tour-selector-open>Начать тур <span aria-hidden="true"><Icon name="arrow-up-right"/></span></button>
  </section>

  <section class="project-contact-v2" id="contact" aria-labelledby="contact-title">
    <div data-project-reveal>
      <p class="project-kicker">EURASIA DE LUXE</p>
      <h2 id="contact-title">Узнать<br/>о квартире</h2>
    </div>
    <div class="project-contact-copy" data-project-reveal>
      <p>Оставьте заявку, чтобы получить подробности о планировках и вариантах интерьера.</p>
      <button type="button" class="project-button project-button-filled" data-project-contact-open>Связаться <span aria-hidden="true"><Icon name="arrow-right"/></span></button>
    </div>
  </section>
  <ApartmentSelector />
</Layout>
