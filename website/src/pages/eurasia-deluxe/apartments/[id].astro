---
import Icon from '../../../components/Icon';
import Layout from '../../../layouts/Layout.astro';
import ApartmentCards from '../../../components/ApartmentCards.astro';
import ApartmentTour from '../../../components/ApartmentTour';
import { apartments } from '../../../data/apartments';
export function getStaticPaths() { return apartments.map(apartment => ({params:{id:apartment.id},props:{apartment}})); }
const {apartment:a} = Astro.props;
---
<Layout title={`${a.rooms}-комнатная квартира ${a.area} м² — Eurasia De Luxe`} description={a.description} image={a.cover}>
  <section class="apartment-v2-hero"><a class="back-to-project" href="/eurasia-deluxe/#apartments"><Icon name="arrow-left"/> Назад к планировкам</a>
    <div class="apartment-v2-intro"><div><p class="project-kicker">{a.rooms}-КОМНАТНАЯ КВАРТИРА</p><h1>{a.area}<span> м²</span></h1></div>
    <div class="apartment-v2-copy"><h2>{a.title}</h2><p>{a.description}</p><div class="apartment-v2-actions"><a href="#tour" class="project-button project-button-filled">Начать тур <span><Icon name="arrow-right"/></span></a><a href="#details" class="project-button project-button-outline">Планировка <span><Icon name="panels-top-left"/></span></a></div></div></div>
  </section>
  <section class="apartment-tour-intro"><span class="project-rule" aria-hidden="true"></span><h2>ПРОГУЛКА ПО КВАРТИРЕ</h2><a href="#details">Планировка <Icon name="arrow-up-right"/></a></section>
  <ApartmentTour scenes={a.scenes} area={a.area} plan={a.plan} client:load />
  <noscript><style>.tour-section{display:none!important}</style><div class="tour-no-js"><p>Для экскурсии с прокруткой включите JavaScript. Фотографии доступны ниже.</p>{a.scenes.map(scene=><figure><img src={scene.poster} alt={scene.room} loading="lazy" width="1736" height="1192"/><figcaption>{scene.room} — {scene.caption}</figcaption></figure>)}</div></noscript>
  <section class="apartment-details-v2" id="details"><div class="details-plan"><span class="project-rule" aria-hidden="true"></span><h2>ПЛАНИРОВКА И ДЕТАЛИ</h2><img src={a.plan} alt={`Планировка квартиры ${a.area} м²`} width="800" height="750" loading="lazy"/><button type="button" class="project-button project-button-outline details-plan-open" data-apartment-plan-open>Увеличить планировку <Icon name="maximize"/></button></div>
  <div class="details-copy"><p class="project-kicker">ХАРАКТЕРИСТИКИ</p><dl><div><dt>Общая площадь</dt><dd>{a.area} м²</dd></div><div><dt>Комнат</dt><dd>{a.rooms}</dd></div><div><dt>Планировка</dt><dd><ul class="details-features">{a.features.map(feature => <li>{feature}</li>)}</ul></dd></div></dl><button type="button" class="project-button project-button-filled" data-project-contact-open>Узнать о квартире <span><Icon name="arrow-right"/></span></button></div></section>
  <section class="apartment-contact-band"><h2>УЗНАТЬ О КВАРТИРЕ</h2><button type="button" class="project-button project-button-light" data-project-contact-open>Связаться <span><Icon name="arrow-right"/></span></button></section>
  <section class="other-apartments-v2"><span class="project-rule" aria-hidden="true"></span><h2>ДРУГИЕ ПЛАНИРОВКИ</h2><ApartmentCards exclude={a.id}/></section>
</Layout>
